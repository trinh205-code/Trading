								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "orders", "{{orderId}}", "cancel"]
						}
					}
				},
				{
					"name": "4.3 Chi tiết lệnh theo ID (Get Order By ID)",
					"request": {
						"method": "GET",
						"header": [
