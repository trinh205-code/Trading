						"url": {
							"raw": "{{baseUrl}}/api/users/me/transfer-pin",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "me", "transfer-pin"]
						}
					}
				},
				{
					"name": "2.5 Đổi Mã OTP (Change Transfer PIN)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"oldPin\": \"6868\",\n  \"newPin\": \"8888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/me/transfer-pin",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "me", "transfer-pin"]
						}
					}
				}
			]
		},
		{
